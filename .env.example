# ============================================================
# AI Clip Studio — configuration locale (copier vers .env)
# Ce fichier est lu UNIQUEMENT par le serveur (services/api).
# Aucune de ces valeurs n'est exposée au frontend.
# ============================================================

# --- Claude API (étape 4) — clé secrète, ne jamais committer ---
ANTHROPIC_API_KEY=
# Modèle de l'analyse approfondie (étape 4b)
CLAUDE_MODEL=claude-opus-5-5
# Modèle du repérage global (économique). Identifiants vérifiés le 23/11/2026 dans la
# documentation officielle ; un modèle sans tarif connu bloque l'analyse (budget non garantissable).
CLAUDE_TRIAGE_MODEL=claude-haiku-5-5

# --- Serveur API (écoute en local uniquement par défaut) ---
API_HOST=127.0.0.1
API_PORT=4000
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- Stockage local (chemins relatifs à la racine du projet) ---
STORAGE_DIR=./storage
DATABASE_PATH=./storage/db/ai-clip-studio.sqlite

# --- Outils externes (nom dans le PATH ou chemin absolu) ---
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Vide = détection automatique de ./.venv (Windows : .venv\Scripts\python.exe)
PYTHON_PATH=

# --- Pistes audio OBS ---
# Rôle de chaque piste, dans l'ordre du fichier (piste 1, piste 2, …).
# Rôles : mic (micro seul), discord (Discord seul), game (jeu sans voix),
#         mix (tout mélangé), unknown.
# Utilisé seulement si les pistes ne sont pas nommées dans OBS
# (un nom contenant « Micro », « Discord », « Tout »/« Mix », « Jeu » est reconnu).
AUDIO_TRACK_ROLES=mix,mic,discord

# --- Cache des fichiers dérivés (WAV, pistes de clip, formes d'onde) ---
# Au-delà, les dérivés les moins récemment utilisés sont supprimés (tous régénérables).
# Les enregistrements originaux, projets et exports ne sont JAMAIS supprimés.
CACHE_MAX_GB=30
# Fenêtre audio préparée autour d'un clip : marge, puis alignement sur une grille
# (deux clips proches réutilisent la même extraction).
CLIP_WINDOW_MARGIN_SEC=30
CLIP_WINDOW_GRID_SEC=30

# --- Faster-Whisper (transcription locale) ---
# Compromis détaillés : docs/transcription.md
# Modèle par défaut et modèles proposés (comparaison dans l'interface / npm run transcribe -- --compare)
WHISPER_MODEL=large-v3-turbo
WHISPER_MODEL_CHOICES=large-v3-turbo,large-v3
# auto (CUDA si disponible, sinon CPU) | cuda | cpu
WHISPER_DEVICE=auto
# Repli sur CPU si CUDA échoue (l'erreur est journalisée ; le périphérique réel est affiché)
WHISPER_CPU_FALLBACK=true
# auto (= float16 sur GPU, int8 sur CPU) | float16 | int8_float16 | int8 | float32
WHISPER_COMPUTE_TYPE=auto
WHISPER_CPU_COMPUTE_TYPE=int8
# auto (détection) ou code de langue imposé (fr, en, …)
WHISPER_LANGUAGE=auto
WHISPER_BEAM_SIZE=5
# 0 = décodage séquentiel ; > 0 = transcription par lots (plus rapide sur GPU, plus de VRAM)
WHISPER_BATCH_SIZE=0
WHISPER_WORD_TIMESTAMPS=true
# Détection de parole (silences)
WHISPER_VAD=true
WHISPER_VAD_THRESHOLD=0.5
WHISPER_VAD_MIN_SILENCE_MS=500
WHISPER_VAD_MIN_SPEECH_MS=250
WHISPER_VAD_SPEECH_PAD_MS=400
# Découpage : zone centrale de chaque bloc, chevauchement avant/après, tolérance aux frontières
WHISPER_CHUNK_SEC=1200
WHISPER_CHUNK_OVERLAP_SEC=30
WHISPER_BOUNDARY_TOLERANCE_MS=1000
# Dossier des modèles téléchargés (jamais nettoyé automatiquement)
WHISPER_MODEL_DIR=./storage/models
# Avancé / tests uniquement : commande du worker en JSON (vide = Python du venv + worker.py)
WHISPER_WORKER_COMMAND=

# --- Analyse éditoriale (étape 4) ---
# Détails : docs/analyse-editoriale.md. `npm run analyze -- <id> --dry-run` prépare et montre
# les requêtes exactes, SANS appel ; `--run` les envoie après confirmation (plafond strict).
# Effort de l'analyse approfondie (Opus) et du repérage (Haiku) : low | medium | high | xhigh | max
ANALYSIS_EFFORT=high
ANALYSIS_TRIAGE_EFFORT=medium
# Un clip exige une pertinence (jugée par Claude) ET une fiabilité (calculée localement) suffisantes
ANALYSIS_MIN_RELEVANCE=60
ANALYSIS_MIN_RELIABILITY=60
# Appels d'analyse approfondie simultanés (le plafond reste garanti quel que soit ce réglage)
ANALYSIS_CONCURRENCY=1
# Tentatives par appel en cas d'erreur passagère (429, 5xx, délai) ; chacune est réservée à part
ANALYSIS_MAX_ATTEMPTS=3
ANALYSIS_REQUEST_TIMEOUT_SEC=600
# Plafond STRICT par analyse, en dollars (réflexion, cache et sorties compris)
ANALYSIS_MAX_COST_USD=5
# Jetons de sortie maximum par appel (réflexion comprise) : bornent le pire cas réservé au budget
ANALYSIS_MAX_OUTPUT_TOKENS=12000
ANALYSIS_TRIAGE_MAX_OUTPUT_TOKENS=4000
# Repérage global : off | signals (autour des signaux locaux) | full (tout le texte autorisé).
# Seule la piste micro est transmise par défaut ; Discord et la piste « tout » exigent
# l'accord explicite de chaque enregistrement.
ANALYSIS_TRIAGE_SCOPE=full
# Durée d'une tranche de repérage
ANALYSIS_TRIAGE_CHUNK_SEC=1200
# Contexte autour d'une zone d'intérêt : proche (texte + images) et lointain (texte seul)
ANALYSIS_CONTEXT_BEFORE_SEC=45
ANALYSIS_CONTEXT_AFTER_SEC=20
ANALYSIS_FAR_CONTEXT_SEC=180
# Score local minimal (0..1) pour qu'une zone devienne une fenêtre candidate
ANALYSIS_LOCAL_MIN_SCORE=0.35
# Images de gameplay par fenêtre (0 = aucune) et largeur. Aucune image sans profil de cadrage validé.
ANALYSIS_FRAMES_PER_WINDOW=4
ANALYSIS_FRAME_WIDTH=1024
# Pseudonymes (noms réels → étiquettes) : fichier HORS dépôt, voir docs/analyse-editoriale.md
ANALYSIS_PRIVACY_FILE=./storage/config/privacy.json
